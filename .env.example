# Copy to `.env` and fill in. `.env` is gitignored — never commit a real key.
#
# Real environment variables take precedence over this file, so an explicit
# `export` always wins.

# Groq API key, for stages 4 (classification) and 6 (drafting).
# Get one at https://console.groq.com -> API Keys
GROQ_API_KEY=gsk_your_key_here

# Which model to use. Run `pulse models --probe` to see which of your account's
# models actually enforce a JSON schema, then put one here.
# PULSE_LLM_MODEL=openai/gpt-oss-120b

# Provider override: groq | fake | none
# PULSE_LLM_PROVIDER=groq

# Recipient for the Gmail draft (stage 10 only, Phase 5).
# PULSE_RECIPIENT=you@example.com

# Bearer token for the deployed MCP server (the server's MCP_AUTH_TOKEN on Railway).
# Secret: keep it here only, never in config files, commits, or chat.
# PULSE_MCP_TOKEN=

# The standing Google Doc each week is appended to (stage 9). Create it once in the
# Google account the MCP server is authorized as; the ID is the part of its URL between
# /document/d/ and /edit. Point this at a scratch doc for a first live run.
# PULSE_DOC_ID=
